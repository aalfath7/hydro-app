# Salin menjadi .env di VPS, lalu: chmod 600 .env
COMPOSE_FILE=compose.prod.yaml
GHCR_OWNER=nama-akun-github
APP_VERSION=1.0.0
TAILSCALE_IP=100.x.y.z
CERT_DIR=./deploy/certs

POSTGRES_DB=hydro
POSTGRES_USER=hydro
POSTGRES_PASSWORD=ganti-dengan-password-panjang

# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ganti-dengan-nilai-acak
DJANGO_ALLOWED_HOSTS=hydro.nama-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://hydro.nama-tailnet.ts.net

NAMA_PERUSAHAAN=Nama Perusahaan
ALAMAT_PERUSAHAAN=Alamat perusahaan
HARI_HAMPIR_KEDALUWARSA=60

# Backup: kunci publik age, dan tujuan rclone di luar VPS
BACKUP_AGE_RECIPIENT=age1xxxxxxxx
BACKUP_RCLONE_TUJUAN=remote:hydro-backup
